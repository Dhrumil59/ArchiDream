<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1920, height=1080" />
    <title>{{TITLE}} — ArchiDream Tour</title>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      body { margin: 0; background: #101014; color: #F4F0E6;
             font-family: Georgia, 'Times New Roman', serif; }
      #root { position: relative; width: 1920px; height: 1080px;
              overflow: hidden; background: #101014; }
      .clip { position: absolute; inset: 0; overflow: hidden; }
      .fill { position: absolute; inset: 0; background: #101014; }

      /* cards */
      .card { display: grid; place-items: center; text-align: center; }
      .card .inner { position: relative; }
      h1 { margin: 0; font-size: 110px; font-weight: 400;
           letter-spacing: 2px; }
      .gold { color: #c9a35c; }
      .stats { margin-top: 26px; font-size: 34px; color: #b9b3a6;
               letter-spacing: 6px; }
      .rule { width: 120px; height: 1px; background: #c9a35c;
              margin: 34px auto 0; }

      /* plan/styled reveal — plan is portrait; cover-fit inside a zoom rig */
      .planrig { position: absolute; left: 50%; top: 50%;
                 width: 1920px; height: 1080px;
                 transform: translate(-50%, -50%); }
      .planbox { position: absolute; left: 50%; top: 50%;
                 width: 1400px;
                 height: calc(1400px * {{PLAN_H}} / {{PLAN_W}});
                 transform: translate(-50%, -50%);
                 transform-origin: {{HERO_CX}}% {{HERO_CY}}%; }
      .planbox img, .planbox svg { position: absolute; inset: 0;
                                   width: 100%; height: 100%; }
      .planbox img { object-fit: fill; }

      /* pano sweep: image taller than frame, panned horizontally */
      .pano { position: absolute; top: -135px; left: 0; height: 1350px;
              width: 2700px; }
      .pano img { width: 100%; height: 100%; object-fit: cover; }

      /* lower third — room name (what space) + director caption underneath */
      .lt { position: absolute; left: 90px; bottom: 84px;
            display: flex; flex-direction: column; align-items: flex-start;
            gap: 10px; }
      .lt .name { font-size: 44px; letter-spacing: 2px;
                  background: rgba(16,16,20,.72); padding: 16px 32px;
                  border-left: 3px solid #c9a35c; }
      .lt .sub { font-size: 30px; font-style: italic; color: #d8cfbf;
                 background: rgba(16,16,20,.55); padding: 8px 22px;
                 letter-spacing: 1px; }

      /* closing */
      .dots { display: flex; gap: 14px; justify-content: center;
              margin-top: 30px; }
      .dot { width: 22px; height: 22px; border-radius: 50%;
             border: 1px solid rgba(244,240,230,.35); }
      .wordmark { margin-top: 40px; font-size: 30px; letter-spacing: 10px;
                  color: #b9b3a6; }
      .tagline { font-size: 64px; font-weight: 400; font-style: italic; }
      .closename { font-size: 58px; letter-spacing: 1px; margin-bottom: 24px;
                   color: #F4F0E6; }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="tour" data-start="0"
         data-width="1920" data-height="1080" data-duration="{{TOTAL}}">

      <!-- 1 · opening card 0–3.5 -->
      <section id="s1" class="clip card" data-start="0" data-duration="3.5"
               data-track-index="1">
        <div class="fill"></div>
        <div class="inner">
          <h1 id="s1-title">{{TITLE}}</h1>
          <div id="s1-rule" class="rule"></div>
          <div id="s1-stats" class="stats">{{STATS}}</div>
        </div>
      </section>

      <!-- 2+3 · reveal & dive 3.5–12 (one clip, continuous zoom) -->
      <section id="s2" class="clip" data-start="3.5" data-duration="8.5"
               data-track-index="1">
        <div class="fill"></div>
        <div class="planrig">
          <div id="s2-box" class="planbox">
            <img id="s2-plan" src="{{PLAN_IMG}}" alt="" />
            <img id="s2-styled" src="{{STYLED_IMG}}" alt="" />
            <svg id="s2-overlay" viewBox="0 0 {{PLAN_W}} {{PLAN_H}}"
                 preserveAspectRatio="none">
              <polygon id="s2-hero" points="{{HERO_POLY}}" fill="none"
                       stroke="#c9a35c" stroke-width="6" />
            </svg>
          </div>
        </div>
      </section>

      <!-- room sweeps — one per included 360, generated by compile_tour.py -->
{{PANO_SECTIONS}}

      <!-- pullback -->
      <section id="s7" class="clip" data-start="{{PULLBACK_START}}" data-duration="3.5"
               data-track-index="1">
        <div class="fill"></div>
        <div class="planrig">
          <div id="s7-box" class="planbox">
            <img id="s7-styled" src="{{STYLED_IMG}}" alt="" />
          </div>
        </div>
      </section>

      <!-- closing card -->
      <section id="s8" class="clip card" data-start="{{CLOSING_START}}"
               data-duration="4" data-track-index="1">
        <div class="fill"></div>
        <div class="inner">
          <div id="s8-title" class="closename">{{TITLE}}</div>
          <div id="s8-tag" class="tagline">“<span
               class="gold">{{TAGLINE}}</span>”</div>
          <div id="s8-dots" class="dots">
            <div class="dot" style="background:{{DOT0}}"></div>
            <div class="dot" style="background:{{DOT1}}"></div>
            <div class="dot" style="background:{{DOT2}}"></div>
            <div class="dot" style="background:{{DOT3}}"></div>
          </div>
          <div id="s8-style" class="stats">{{STYLE_NAME}}</div>
          <div id="s8-mark" class="wordmark">A R C H I D R E A M</div>
        </div>
      </section>
    </div>

    <script>
      window.__timelines = window.__timelines || {};
      const tl = gsap.timeline({ paused: true });

      /* 1 · opening card */
      tl.from("#s1-title", { y: 40, opacity: 0, duration: 0.9,
                             ease: "power3.out" }, 0.25);
      tl.from("#s1-rule", { scaleX: 0, duration: 0.6 }, 0.9);
      tl.from("#s1-stats", { opacity: 0, duration: 0.7 }, 1.2);

      /* 2 · reveal: styled fades over the aligned plan while zooming in;
         3 · dive: zoom continues into the hero room, outline glows */
      tl.set("#s2-styled", { opacity: 0 }, 3.5);
      tl.set("#s2-hero", { opacity: 0 }, 3.5);
      tl.fromTo("#s2-box", { scale: 0.78 }, { scale: 1.0, duration: 4.5,
                ease: "power1.inOut" }, 3.5);
      tl.to("#s2-styled", { opacity: 1, duration: 2.2,
                            ease: "power2.inOut" }, 4.6);
      tl.to("#s2-box", { scale: 2.1, duration: 3.6,
                         ease: "power2.inOut" }, 8.2);
      tl.to("#s2-hero", { opacity: 1, duration: 0.5 }, 8.6);
      tl.to("#s2-hero", { opacity: 0.25, duration: 0.55, repeat: 3,
                          yoyo: true, ease: "sine.inOut" }, 9.1);

      /* room sweeps (alternating directions) — generated */
{{PANO_TWEENS}}

      /* pullback */
      tl.fromTo("#s7-box", { scale: 1.7 }, { scale: 0.82, duration: 3.5,
                ease: "power2.inOut" }, {{PULLBACK_START}});

      /* closing card */
      tl.from("#s8-title", { y: 30, opacity: 0, duration: 0.8,
                             ease: "power3.out" }, {{TITLE_AT}});
      tl.from("#s8-tag", { y: 36, opacity: 0, duration: 0.9,
                           ease: "power3.out" }, {{TAG_AT}});
      tl.from("#s8-dots", { opacity: 0, duration: 0.6 }, {{DOTS_AT}});
      tl.from("#s8-style", { opacity: 0, duration: 0.6 }, {{STYLE_AT}});
      tl.from("#s8-mark", { opacity: 0, y: 18,
                            duration: 1.0, ease: "power2.out" }, {{MARK_AT}});

      window.__timelines["tour"] = tl;
    </script>
  </body>
</html>
