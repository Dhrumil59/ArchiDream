# ArchiDream API keys — copy this file to ".env" and fill in.
# NEVER commit the real .env (it is gitignored).
#
# With NO key set, the app still runs end-to-end in preview mode
# (watermarked placeholder images), so it demos offline.

# Image generation — Nano Banana (Google Gemini). Required for real renders.
GEMINI_API_KEY=

# Optional — Qwen image model (Alibaba DashScope).
# Also required for region-edit (polygon inpaint) feature.
DASHSCOPE_API_KEY=

# IBM watsonx.ai — Granite director for tour video shot-planning.
# Get these from cloud.ibm.com → watsonx.ai → your project → Manage.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Optional — override the default image model.
# NANO_MODEL=gemini-3-pro-image-preview
